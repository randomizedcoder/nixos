+					int nhoff, int hlen);
 
 /* Forward declaration: flow_keys_dissector_symmetric is defined later
  * in this file (it is static, not extern'd through the header). The
@@ -1149,6 +1156,11 @@ static bool flow_dissect_fast_ipv4(const struct sk_buff *skb,
 						data, htons(ETH_P_IPV6),
 						nhoff + (int)sizeof(*iph), hlen);
 		}
