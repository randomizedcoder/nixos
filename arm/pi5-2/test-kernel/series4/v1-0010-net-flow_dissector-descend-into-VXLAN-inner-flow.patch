 		break;
 	default:
 		/* MPLS unicast/multicast + everything else (LCP, IPCP,
@@ -1527,7 +1687,7 @@ static bool flow_dissect_fast_pppoe(const struct sk_buff *skb,
 
 	nhoff += PPPOE_SES_HLEN;
 
