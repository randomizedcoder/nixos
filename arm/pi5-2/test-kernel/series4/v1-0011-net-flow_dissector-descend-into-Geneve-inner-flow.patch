From 86c3a49262e4e04fbb25d1108c1814e13f7a7f44 Mon Sep 17 00:00:00 2001
From: Dave Seddon <dave.seddon.ca@gmail.com>
Date: Thu, 9 Jul 2026 21:29:12 -0700
Subject: [PATCH net-next v1 11/15] net: flow_dissector: descend into Geneve
 inner flow

Opt-in, off by default, byte-identical between the fast and slow paths.
Direct companion to vxlan_inner: same rationale (Geneve overlays hash
on the outer UDP today, collapsing inner flows), same posture.

Both paths grow the same descent:

  - flow_dissect_fast_ipv4() descends when the outer is eth + IPv4 +
    UDP, dst port == GENEVE_UDP_PORT (6081), Geneve version 0, opt_len
    0 (no TLV options) and proto_type ETH_P_TEB, routing the inner
    Eth + IPv4/IPv6 through the shared flow_dissect_fast_udp_inner()
    tail (bounded, ENCAP stamped after the inner pass).
  - __skb_flow_dissect_udp_encap() grows the matching slow-path descent
    and re-enters the loop, bounded by skb_flow_dissect_allowed().

Kept out of the descended set on both paths (so both keep the outer
keys, and fast == slow holds): Geneve with options (opt_len > 0),
OAM control frames (the O bit; RFC 8926 says these are not data),
proto_type other than ETH_P_TEB, and Geneve-over-IPv6 outer. Covered
by the KUnit equivalence suite.

CPU is ~net-zero; the operator benefit is the inner-flow hash
distribution.

Assisted-by: Claude:claude-fable-5 sparse
Signed-off-by: Dave Seddon <dave.seddon.ca@gmail.com>
---
 Documentation/admin-guide/sysctl/net.rst | 26 +++++++++++
 include/net/flow_dissector.h             |  1 +
 net/core/flow_dissector.c                | 56 +++++++++++++++++++++++-
 3 files changed, 82 insertions(+), 1 deletion(-)

diff --git a/Documentation/admin-guide/sysctl/net.rst b/Documentation/admin-guide/sysctl/net.rst
index 4e327e28085b..3c3319bb229f 100644
--- a/Documentation/admin-guide/sysctl/net.rst
+++ b/Documentation/admin-guide/sysctl/net.rst
@@ -615,6 +615,32 @@ the same descent), so the choice is only *whether* to descend, not
 
 Default: 0
 
+geneve_inner
+~~~~~~~~~~~~
+
+Descends into the Geneve inner Eth + IPv4/IPv6 + TCP/UDP flow for
+hashing when the outer matches Eth + IPv4 + UDP with dst port
+``GENEVE_UDP_PORT`` (6081), Geneve version=0, opt_len=0 (no TLV
+options), and proto_type=``ETH_P_TEB`` (the standard transparent-
+Ethernet inner envelope used by k8s/cloud overlays). When enabled,
+the inner 5-tuple replaces the outer one in the flow_keys output,
+and key_control->flags gets FLOW_DIS_ENCAPSULATION set.
+
+**Enabling this changes hashing** for Geneve traffic -- direct
+companion to ``vxlan_inner`` above. The dissector stops at the outer
+UDP header by default; descending gives Geneve overlays per-inner-flow
+fairness in cake / fq / fib_multipath / RPS. Because it changes the
+hash it is off by default and gated independently. Once on it is
+byte-identical between the fast and slow paths (the slow path grows
+the same descent).
+
+Kept out of the descended set (both paths keep the outer keys): Geneve
+with options (opt_len > 0), proto_type other than ETH_P_TEB (rare
+L3-Geneve variants), and Geneve-over-IPv6 outer (only IPv4 outer is
+handled).
+
+Default: 0
+
 3. /proc/sys/net/unix - Parameters for Unix domain sockets
 ----------------------------------------------------------
 
diff --git a/include/net/flow_dissector.h b/include/net/flow_dissector.h
index b10d910be33c..778f31e6e3bc 100644
--- a/include/net/flow_dissector.h
+++ b/include/net/flow_dissector.h
@@ -436,6 +436,7 @@ extern struct static_key_false flow_dissector_mpls_key;
 extern struct static_key_false flow_dissector_ipip_key;
 extern struct static_key_false flow_dissector_gre_key;
 extern struct static_key_false flow_dissector_vxlan_inner_key;
+extern struct static_key_false flow_dissector_geneve_inner_key;
 
 /* Per-shape counters for /proc/net/flow_dissector_stats.
  * occurrences[]: shape seen by the slow path (the eligible-fraction
diff --git a/net/core/flow_dissector.c b/net/core/flow_dissector.c
index 58a33bd48b60..d2c396edbb12 100644
--- a/net/core/flow_dissector.c
+++ b/net/core/flow_dissector.c
@@ -66,6 +66,8 @@ DEFINE_STATIC_KEY_FALSE(flow_dissector_gre_key);
 EXPORT_SYMBOL(flow_dissector_gre_key);
 DEFINE_STATIC_KEY_FALSE(flow_dissector_vxlan_inner_key);
 EXPORT_SYMBOL(flow_dissector_vxlan_inner_key);
+DEFINE_STATIC_KEY_FALSE(flow_dissector_geneve_inner_key);
+EXPORT_SYMBOL(flow_dissector_geneve_inner_key);
 
 /* Per-cpu, summed on read via /proc/net/flow_dissector_stats.
  * occurrences[]: shape handled by the slow path (with the gate off,
@@ -229,6 +231,42 @@ flow_dissect_vxlan_inner_ok(const void *data, int thoff, int hlen, u8 family,
 	return true;
 }
 
+static __always_inline bool
+flow_dissect_geneve_inner_ok(const void *data, int thoff, int hlen, u8 family,
+			     __be16 *inner_proto, int *inner_nhoff)
+{
+	const struct ethhdr *inner_eth;
+	const struct genevehdr *gnv;
+	const __be16 *udp_ports;
+
+	if (family != AF_INET)
+		return false;
+	if (hlen - thoff < (int)(sizeof(struct udphdr) +
+				 sizeof(struct genevehdr) + ETH_HLEN))
+		return false;
+	udp_ports = (const __be16 *)((const u8 *)data + thoff);
+	if (udp_ports[1] != htons(GENEVE_UDP_PORT))
+		return false;
+	gnv = (const struct genevehdr *)
+		((const u8 *)data + thoff + sizeof(struct udphdr));
+	/* Version 0, no options, no OAM (control traffic, RFC 8926
+	 * §3.1), transparent-Ethernet inner only.
+	 */
+	if (gnv->ver != 0 || gnv->opt_len != 0 || gnv->oam ||
+	    gnv->proto_type != htons(ETH_P_TEB))
+		return false;
+	inner_eth = (const struct ethhdr *)
+		((const u8 *)data + thoff + sizeof(struct udphdr) +
+		 sizeof(struct genevehdr));
+	if (inner_eth->h_proto != htons(ETH_P_IP) &&
+	    inner_eth->h_proto != htons(ETH_P_IPV6))
+		return false;
+	*inner_proto = inner_eth->h_proto;
+	*inner_nhoff = thoff + sizeof(struct udphdr) +
+		       sizeof(struct genevehdr) + ETH_HLEN;
+	return true;
+}
+
 /* Try the UDP-tunnel descents on an outer UDP header at @thoff. A
  * packet the classifiers accept but the inner fast path cannot handle
  * defers, because the slow path will descend into it.
@@ -249,6 +287,10 @@ flow_dissect_fast_udp_tunnels(const struct sk_buff *skb,
 	    flow_dissect_vxlan_inner_ok(data, thoff, hlen, family,
 					&inner_proto, &inner_nhoff))
 		goto descend;
+	if (static_branch_unlikely(&flow_dissector_geneve_inner_key) &&
+	    flow_dissect_geneve_inner_ok(data, thoff, hlen, family,
+					 &inner_proto, &inner_nhoff))
+		goto descend;
 	return FAST_TUNNEL_NONE;
 
 descend:
@@ -1997,6 +2039,10 @@ static bool __skb_flow_dissect_udp_encap(const struct sk_buff *skb,
 	    flow_dissect_vxlan_inner_ok(data, thoff, hlen, family,
 					&inner_proto, &inner_nhoff))
 		goto descend;
+	if (static_branch_unlikely(&flow_dissector_geneve_inner_key) &&
+	    flow_dissect_geneve_inner_ok(data, thoff, hlen, family,
+					 &inner_proto, &inner_nhoff))
+		goto descend;
 	return false;
 
 descend:
@@ -2682,7 +2728,8 @@ bool __skb_flow_dissect(const struct net *net,
 	    !(key_control->flags & FLOW_DIS_IS_FRAGMENT) &&
 	    !(flags & (FLOW_DISSECTOR_F_STOP_BEFORE_ENCAP |
 		       FLOW_DISSECTOR_F_STOP_AT_ENCAP)) &&
-	    static_branch_unlikely(&flow_dissector_vxlan_inner_key) &&
+	    (static_branch_unlikely(&flow_dissector_vxlan_inner_key) ||
+	     static_branch_unlikely(&flow_dissector_geneve_inner_key)) &&
 	    __skb_flow_dissect_udp_encap(skb, key_control, data, &proto, &nhoff,
 					 hlen,
 					 proto == htons(ETH_P_IP) ? AF_INET :
@@ -3256,6 +3303,13 @@ static struct ctl_table flow_dissector_sysctl_table[] = {
 		.mode		= 0644,
 		.proc_handler	= proc_do_static_key,
 	},
+	{
+		.procname	= "geneve_inner",
+		.data		= &flow_dissector_geneve_inner_key.key,
+		.maxlen		= sizeof(flow_dissector_geneve_inner_key),
+		.mode		= 0644,
+		.proc_handler	= proc_do_static_key,
+	},
 };
 
 static const char * const flow_dissector_shape_names[FLOW_DISSECTOR_SHAPE__MAX] = {
-- 
