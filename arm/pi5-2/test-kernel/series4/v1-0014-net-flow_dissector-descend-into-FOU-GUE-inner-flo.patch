+
+		if (type == FOU_ENCAP_GUE &&
+		    static_branch_unlikely(&flow_dissector_gue_inner_key)) {
+			int gue_off = thoff + (int)sizeof(struct udphdr);
+			const struct guehdr *guehdr;
+			__be16 inner_proto;
+			int hdrlen;
+
+			if (hlen - gue_off < (int)sizeof(*guehdr))
+				return false;
+			guehdr = (const struct guehdr *)
+				((const u8 *)data + gue_off);
+			if (guehdr->version != 0 || guehdr->control ||
+			    (guehdr->flags & ~GUE_FLAGS_ALL))
+				return false;
+			switch (guehdr->proto_ctype) {
+			case IPPROTO_IPIP:
+				inner_proto = htons(ETH_P_IP);
+				break;
+			case IPPROTO_IPV6:
+				inner_proto = htons(ETH_P_IPV6);
+				break;
+			default:
+				return false;
+			}
+			hdrlen = (int)sizeof(*guehdr) + guehdr->hlen * 4;
+			if (hlen - gue_off < hdrlen)
+				return false;
+			*p_proto = inner_proto;
+			*p_nhoff = gue_off + hdrlen;
+			key_control->flags |= FLOW_DIS_ENCAPSULATION;
+			return true;
+		}
+		if (type == FOU_ENCAP_DIRECT &&
+		    static_branch_unlikely(&flow_dissector_fou_inner_key)) {
+			__be16 inner_proto;
+
+			switch (ipproto) {
+			case IPPROTO_IPIP:
+				inner_proto = htons(ETH_P_IP);
+				break;
+			case IPPROTO_IPV6:
+				inner_proto = htons(ETH_P_IPV6);
+				break;
+			default:
+				return false;
+			}
+			*p_proto = inner_proto;
+			*p_nhoff = thoff + (int)sizeof(struct udphdr);
+			key_control->flags |= FLOW_DIS_ENCAPSULATION;
+			return true;
+		}
+	}
+
 	return false;
 }
 
