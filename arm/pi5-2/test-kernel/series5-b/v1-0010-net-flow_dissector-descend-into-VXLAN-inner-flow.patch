+	/* UDP-tunnel inner descents. Opt-in and off by default --
+	 * descending changes skb->hash for tunnel traffic, so enabling
+	 * any *_inner gate is a deliberate operator choice. Byte-
+	 * identical with the slow path, which descends through the same
+	 * classifiers in __skb_flow_dissect_udp_encap().
+	 */
+	if (iph->protocol == IPPROTO_UDP) {
+		switch (flow_dissect_fast_udp_tunnels(skb, flow_dissector,
+						      target_container, data,
+						      thoff, hlen, num_hdrs,
+						      AF_INET)) {
+		case FAST_TUNNEL_DISSECTED:
+			return true;
+		case FAST_TUNNEL_DEFER:
+			return false;
+		case FAST_TUNNEL_NONE:
+			break;
+		}
+	}
+
 	return true;
 }
 
@@ -1366,6 +1515,20 @@ static bool flow_dissect_fast_ipv6(const struct sk_buff *skb,
 		key_ports->ports = *ports;
 	}
 
+	if (iph->nexthdr == IPPROTO_UDP) {
+		switch (flow_dissect_fast_udp_tunnels(skb, flow_dissector,
+						      target_container, data,
+						      thoff, hlen, num_hdrs,
+						      AF_INET6)) {
+		case FAST_TUNNEL_DISSECTED:
+			return true;
+		case FAST_TUNNEL_DEFER:
+			return false;
+		case FAST_TUNNEL_NONE:
+			break;
+		}
+	}
+
 	return true;
 }
 
@@ -1486,7 +1649,7 @@ static bool flow_dissect_fast_pppoe(const struct sk_buff *skb,
 		struct pppoe_hdr hdr;
 		__be16 proto;
 	} *hdr;
-	__be16 inner_eth_proto;
+	__be16 inner_proto;
 	u16 ppp_proto;
 	bool ok;
 
@@ -1499,10 +1662,10 @@ static bool flow_dissect_fast_pppoe(const struct sk_buff *skb,
 	ppp_proto = ntohs(hdr->proto);
 	switch (ppp_proto) {
 	case PPP_IP:
-		inner_eth_proto = htons(ETH_P_IP);
+		inner_proto = htons(ETH_P_IP);
 		break;
 	case PPP_IPV6:
-		inner_eth_proto = htons(ETH_P_IPV6);
+		inner_proto = htons(ETH_P_IPV6);
 		break;
 	default:
 		/* MPLS unicast/multicast + everything else (LCP, IPCP,
@@ -1523,7 +1686,7 @@ static bool flow_dissect_fast_pppoe(const struct sk_buff *skb,
 
 	nhoff += PPPOE_SES_HLEN;
 
-	if (inner_eth_proto == htons(ETH_P_IP))
+	if (inner_proto == htons(ETH_P_IP))
 		ok = flow_dissect_fast_ipv4(skb, flow_dissector,
 					    target_container, data,
 					    nhoff, hlen, 2);
@@ -1613,7 +1776,7 @@ static bool flow_dissect_fast_ipip_inner(const struct sk_buff *skb,
 					 struct flow_dissector *flow_dissector,
 					 void *target_container,
 					 const void *data,
-					 __be16 inner_eth_proto,
+					 __be16 inner_proto,
 					 int inner_nhoff, int hlen, int num_hdrs)
 {
 	struct flow_dissector_key_control *key_control;
@@ -1625,11 +1788,11 @@ static bool flow_dissect_fast_ipip_inner(const struct sk_buff *skb,
 	if (++num_hdrs > MAX_FLOW_DISSECT_HDRS)
 		return false;
 
-	if (inner_eth_proto == htons(ETH_P_IP))
+	if (inner_proto == htons(ETH_P_IP))
 		ok = flow_dissect_fast_ipv4(skb, flow_dissector,
 					    target_container, data,
 					    inner_nhoff, hlen, num_hdrs);
-	else if (inner_eth_proto == htons(ETH_P_IPV6))
+	else if (inner_proto == htons(ETH_P_IPV6))
 		ok = flow_dissect_fast_ipv6(skb, flow_dissector,
 					    target_container, data,
 					    inner_nhoff, hlen, num_hdrs);
@@ -1810,6 +1973,38 @@ static bool flow_dissect_fast(const struct sk_buff *skb,
 	}
 }
 
+/* Slow-path counterpart of flow_dissect_fast_udp_tunnels(): the same
+ * classifiers define the descent subset, so fast == slow is structural.
+ * On a match, rewrite *p_proto / *p_nhoff to the inner flow and return
+ * true; the caller re-enters the loop (bounded by
+ * skb_flow_dissect_allowed()). @thoff is the outer UDP offset, @family
+ * the outer IP family.
+ */
+static bool __skb_flow_dissect_udp_encap(const struct sk_buff *skb,
+					 struct flow_dissector_key_control *key_control,
+					 const void *data, __be16 *p_proto,
+					 int *p_nhoff, int hlen, u8 family)
+{
+	int thoff = *p_nhoff;
+	__be16 inner_proto;
+	int inner_nhoff;
+
+	if (hlen - thoff < (int)sizeof(struct udphdr))
+		return false;
+
+	if (static_branch_unlikely(&flow_dissector_vxlan_inner_key) &&
+	    flow_dissect_vxlan_inner_ok(data, thoff, hlen,
+					&inner_proto, &inner_nhoff))
+		goto descend;
+	return false;
+
+descend:
+	*p_proto = inner_proto;
+	*p_nhoff = inner_nhoff;
+	key_control->flags |= FLOW_DIS_ENCAPSULATION;
+	return true;
+}
+
 /**
  * __skb_flow_dissect - extract the flow_keys struct and return it
  * @net: associated network namespace, derived from @skb if NULL
@@ -2481,6 +2676,22 @@ bool __skb_flow_dissect(const struct net *net,
 		__skb_flow_dissect_ports(skb, flow_dissector, target_container,
 					 data, nhoff, ip_proto, hlen);
 
+	/* Opt-in UDP-tunnel descent, mirroring the fast path so fast == slow.
+	 * Skipped for callers stopping at/before encap (they want the outer
+	 * tuple) and for fragmented outers.
+	 */
+	if (ip_proto == IPPROTO_UDP &&
+	    fdret == FLOW_DISSECT_RET_CONTINUE &&
+	    !(key_control->flags & FLOW_DIS_IS_FRAGMENT) &&
+	    !(flags & (FLOW_DISSECTOR_F_STOP_BEFORE_ENCAP |
+		       FLOW_DISSECTOR_F_STOP_AT_ENCAP)) &&
+	    static_branch_unlikely(&flow_dissector_udp_inner_any_key) &&
+	    __skb_flow_dissect_udp_encap(skb, key_control, data, &proto, &nhoff,
+					 hlen,
+					 proto == htons(ETH_P_IP) ? AF_INET :
+								    AF_INET6))
+		fdret = FLOW_DISSECT_RET_PROTO_AGAIN;
+
 	/* Process result of IP proto processing */
 	switch (fdret) {
 	case FLOW_DISSECT_RET_PROTO_AGAIN:
@@ -2991,6 +3202,32 @@ static int proc_set_qinq_key(const struct ctl_table *table, int write,
 	return ret;
 }
 
+/* The slow path gates the UDP-tunnel descent behind one summary key
+ * (flow_dissector_udp_inner_any_key); recompute it after every
+ * individual descent-gate write.
+ */
+static void flow_dissector_udp_inner_recompute(void)
+{
+	bool any = static_key_enabled(&flow_dissector_vxlan_inner_key);
+
+	if (any != static_key_enabled(&flow_dissector_udp_inner_any_key)) {
+		if (any)
+			static_branch_enable(&flow_dissector_udp_inner_any_key);
+		else
+			static_branch_disable(&flow_dissector_udp_inner_any_key);
+	}
+}
+
+static int proc_set_udp_inner_key(const struct ctl_table *table, int write,
+				  void *buffer, size_t *lenp, loff_t *ppos)
+{
+	int ret = proc_do_static_key(table, write, buffer, lenp, ppos);
+
+	if (!ret && write)
+		flow_dissector_udp_inner_recompute();
+	return ret;
+}
+
 static struct ctl_table flow_dissector_sysctl_table[] = {
 	{
 		.procname	= "eth_ip",
@@ -3041,6 +3278,13 @@ static struct ctl_table flow_dissector_sysctl_table[] = {
 		.mode		= 0644,
 		.proc_handler	= proc_do_static_key,
 	},
+	{
+		.procname	= "vxlan_inner",
+		.data		= &flow_dissector_vxlan_inner_key.key,
+		.maxlen		= sizeof(flow_dissector_vxlan_inner_key),
+		.mode		= 0644,
+		.proc_handler	= proc_set_udp_inner_key,
+	},
 };
 
 static const char * const flow_dissector_shape_names[FLOW_DISSECTOR_SHAPE__MAX] = {
@@ -3119,8 +3363,8 @@ static int __init flow_dissector_sysctl_init(void)
 				 flow_dissector_sysctl_table))
 		return -ENOMEM;
 
