 static struct flow_dissector flow_keys_dissector_symmetric;
 
+/* Maximum number of protocol headers that can be parsed in
+ * __skb_flow_dissect
+ */
+#define MAX_FLOW_DISSECT_HDRS	15
+
+/* Shared tail for the UDP-tunnel inner descents (VXLAN / Geneve / GTP-U /
+ * FOU / GUE). Given the inner ethertype and inner offset, it:
+ *   - bounds the MAX_FLOW_DISSECT_HDRS budget, so a crafted overlay-in-
+ *     overlay chain neither recurses without bound (stack safety) nor
+ *     descends past the depth the slow path stops at (byte-identity);
+ *   - tail-calls the inner IPv4/IPv6 fast-path;
+ *   - stamps FLOW_DIS_ENCAPSULATION *after* the inner returns — the inner
+ *     leaf zeroes key_control->flags, so the ENCAP write must come last.
+ * Returns false (defer to the slow path) when the inner is not fast-pathable
+ * or the header budget is exhausted. UDP-tunnel descents are intentionally
+ * not per-shape counted, so no flow_dissector_count_fast() here.
+ */
+static bool flow_dissect_fast_udp_inner(const struct sk_buff *skb,
+					struct flow_dissector *flow_dissector,
+					void *target_container,
+					const void *data,
+					__be16 inner_proto,
+					int inner_nhoff, int hlen, int num_hdrs)
+{
+	struct flow_dissector_key_control *key_control;
+	bool ok;
+
+	if (++num_hdrs > MAX_FLOW_DISSECT_HDRS)
+		return false;
+
+	if (inner_proto == htons(ETH_P_IP))
+		ok = flow_dissect_fast_ipv4(skb, flow_dissector, target_container,
+					    data, inner_nhoff, hlen, num_hdrs);
+	else if (inner_proto == htons(ETH_P_IPV6))
+		ok = flow_dissect_fast_ipv6(skb, flow_dissector, target_container,
+					    data, inner_nhoff, hlen, num_hdrs);
+	else
+		return false;
+	if (!ok)
+		return false;
+
+	if (dissector_uses_key(flow_dissector, FLOW_DISSECTOR_KEY_CONTROL)) {
+		key_control = skb_flow_dissector_target(flow_dissector,
+							FLOW_DISSECTOR_KEY_CONTROL,
+							target_container);
+		key_control->flags |= FLOW_DIS_ENCAPSULATION;
+	}
+	return true;
+}
+
+/* Result of trying the UDP-tunnel descents on an outer UDP header. */
+enum flow_dissect_fast_tunnel {
+	FAST_TUNNEL_NONE,	/* no descent: the outer dissection stands */
+	FAST_TUNNEL_DISSECTED,	/* descended; inner keys written */
+	FAST_TUNNEL_DEFER,	/* would descend; inner not fast-pathable */
+};
+
+/* Tunnel classifiers, shared verbatim by the fast path and the slow
+ * path's __skb_flow_dissect_udp_encap(): each validates one tunnel
+ * header at UDP offset @thoff and returns the inner network protocol
+ * and offset. Defining the descent subset once makes fast == slow
+ * byte-identity structural rather than maintained by hand.
+ */
+static __always_inline bool
+flow_dissect_vxlan_inner_ok(const void *data, int thoff, int hlen,
+			    __be16 *inner_proto, int *inner_nhoff)
+{
+	const struct ethhdr *inner_eth;
+	const struct vxlanhdr *vxh;
+	const __be16 *udp_ports;
+
+	if (hlen - thoff < (int)(sizeof(struct udphdr) +
+				 sizeof(struct vxlanhdr) + ETH_HLEN))
+		return false;
+	udp_ports = (const __be16 *)((const u8 *)data + thoff);
+	if (udp_ports[1] != htons(IANA_VXLAN_UDP_PORT))
+		return false;
+	vxh = (const struct vxlanhdr *)
+		((const u8 *)data + thoff + sizeof(struct udphdr));
+	/* Only plain RFC 7348 VXLAN: I flag set, every other flag bit
+	 * zero (GBP / GPE keep the outer keys).
+	 */
+	if (vxh->vx_flags != VXLAN_HF_VNI)
+		return false;
+	inner_eth = (const struct ethhdr *)
+		((const u8 *)data + thoff + sizeof(struct udphdr) +
+		 sizeof(struct vxlanhdr));
+	if (inner_eth->h_proto != htons(ETH_P_IP) &&
+	    inner_eth->h_proto != htons(ETH_P_IPV6))
+		return false;
+	*inner_proto = inner_eth->h_proto;
+	*inner_nhoff = thoff + sizeof(struct udphdr) +
+		       sizeof(struct vxlanhdr) + ETH_HLEN;
+	return true;
+}
+
+/* Try the UDP-tunnel descents on an outer UDP header at @thoff. A
+ * packet the classifiers accept but the inner fast path cannot handle
+ * defers, because the slow path will descend into it.
+ */
+static enum flow_dissect_fast_tunnel
+flow_dissect_fast_udp_tunnels(const struct sk_buff *skb,
+			      struct flow_dissector *flow_dissector,
+			      void *target_container, const void *data,
+			      int thoff, int hlen, int num_hdrs, u8 family)
+{
+	__be16 inner_proto;
+	int inner_nhoff;
+
+	if (hlen - thoff < (int)sizeof(struct udphdr))
+		return FAST_TUNNEL_NONE;
+
+	if (static_branch_unlikely(&flow_dissector_vxlan_inner_key) &&
+	    flow_dissect_vxlan_inner_ok(data, thoff, hlen,
+					&inner_proto, &inner_nhoff))
+		goto descend;
+	return FAST_TUNNEL_NONE;
+
+descend:
+	return flow_dissect_fast_udp_inner(skb, flow_dissector,
+					   target_container, data, inner_proto,
+					   inner_nhoff, hlen, num_hdrs) ?
+	       FAST_TUNNEL_DISSECTED : FAST_TUNNEL_DEFER;
+}
+
 static void dissector_set_key(struct flow_dissector *flow_dissector,
 			      enum flow_dissector_key_id key_id)
 {
@@ -1009,11 +1143,6 @@ __skb_flow_dissect_ipv6(const struct sk_buff *skb,
 	key_ip->ttl = iph->hop_limit;
 }
 
