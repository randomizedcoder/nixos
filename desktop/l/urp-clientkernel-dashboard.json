{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "urp client vs kernel (throughput + RTT)",
  "uid": "urp-clientkernel",
  "tags": ["urp", "urp-bench", "design-51", "design-53"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "endpoint",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(endpoint)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "Both sides live",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Client /metrics up (job=urp_bench)",
      "description": "Bench clients serving /metrics. DOWN between runs is expected.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "up", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "urp_bench_up{endpoint=~\"$endpoint\"}", "legendFormat": "{{instance}} {{endpoint}} {{role}}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Kernel exporter up (job=urp)",
      "description": "urp-exporter on the mesh nodes (hp*:9975) — the kernel-side counters. Always-on.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "up", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "up{job=\"urp\"}", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Drops — client AND kernel (must be 0)",
      "description": "Client-observed loss (seq dups/unknowns + verify + deframe) alongside the kernel's own reorder_drops. Both zero = the independent 'no drops' agreement across the UDS boundary.",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(urp_bench_seq_dups_total{endpoint=~\"$endpoint\"}) + sum(urp_bench_seq_unknowns_total{endpoint=~\"$endpoint\"}) + sum(urp_bench_verify_failures_total{endpoint=~\"$endpoint\"}) + sum(urp_bench_deframe_errors_total{endpoint=~\"$endpoint\"})", "legendFormat": "client drops" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(urp_endpoint_reorder_drops_total{endpoint=~\"$endpoint\"})", "legendFormat": "kernel reorder_drops" }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Throughput — client UDS vs kernel RDMA",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Throughput: client UDS vs kernel RDMA (bytes/s)",
      "description": "Client's UDS read/write rate (job=urp_bench) overlaid with the kernel endpoint's RDMA tx/rx rate (job=urp). They should track — the client bounds the RDMA path end-to-end without trusting the kernel counter (design 51).",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "CTX", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (endpoint) (rate(urp_bench_uds_tx_bytes_total{endpoint=~\"$endpoint\"}[$__rate_interval]))", "legendFormat": "client tx {{endpoint}}" },
        { "refId": "CRX", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (endpoint) (rate(urp_bench_uds_rx_bytes_total{endpoint=~\"$endpoint\"}[$__rate_interval]))", "legendFormat": "client rx {{endpoint}}" },
        { "refId": "KTX", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (endpoint) (rate(urp_endpoint_tx_bytes_total{endpoint=~\"$endpoint\"}[$__rate_interval]))", "legendFormat": "kernel tx {{endpoint}}" },
        { "refId": "KRX", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (endpoint) (rate(urp_endpoint_rx_bytes_total{endpoint=~\"$endpoint\"}[$__rate_interval]))", "legendFormat": "kernel rx {{endpoint}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reconciliation: client / kernel throughput ratio (≈ 1)",
      "description": "Aggregate client UDS bytes/s divided by kernel RDMA bytes/s. Near 1.0 means the client's independent view agrees with the kernel counters; a persistent drift is a discrepancy worth chasing (headers vs payload account for a small constant offset).",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 3, "custom": { "drawStyle": "line", "fillOpacity": 5, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.9 }, { "color": "red", "value": 1.5 } ] } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(urp_bench_uds_tx_bytes_total{endpoint=~\"$endpoint\"}[$__rate_interval])) / clamp_min(sum(rate(urp_endpoint_tx_bytes_total{endpoint=~\"$endpoint\"}[$__rate_interval])), 1)", "legendFormat": "client tx / kernel tx" }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Latency — client echo RTT vs kernel probe/OWD/send-lat",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency: client echo RTT vs kernel probe RTT / 2×OWD / send-lat (s)",
      "description": "The client's measured echo RTT (histogram p50/p99) should ENVELOPE the kernel's own signals: the software PING/PONG probe RTT (urp_qp_rtt_ns), 2× the one-way delay (urp_endpoint_owd_seconds, PTP-synced), and the data-path send-completion latency (urp_qp_send_lat_ns, design 52). Δ = UDS + proxy overhead.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 3, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "CP50", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(urp_bench_rtt_seconds_bucket{endpoint=~\"$endpoint\"}[$__rate_interval])))", "legendFormat": "client RTT p50" },
        { "refId": "CP99", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(urp_bench_rtt_seconds_bucket{endpoint=~\"$endpoint\"}[$__rate_interval])))", "legendFormat": "client RTT p99" },
        { "refId": "KPROBE", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(urp_qp_rtt_ns{endpoint=~\"$endpoint\"}) / 1e9", "legendFormat": "kernel probe RTT (avg)" },
        { "refId": "KOWD", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "2 * histogram_quantile(0.50, sum by (le) (rate(urp_endpoint_owd_seconds_bucket{endpoint=~\"$endpoint\"}[$__rate_interval])))", "legendFormat": "kernel 2×OWD p50" },
        { "refId": "KSEND", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(urp_qp_send_lat_ns{endpoint=~\"$endpoint\"}) / 1e9", "legendFormat": "kernel send-lat (avg)" }
      ]
    },
    {
      "id": 7,
      "type": "heatmap",
      "title": "Client echo RTT distribution (heatmap)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "calculate": false, "cellGap": 1, "yAxis": { "unit": "s", "scale": { "type": "log", "log": 10 } }, "color": { "scheme": "Spectral", "mode": "scheme" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (le) (rate(urp_bench_rtt_seconds_bucket{endpoint=~\"$endpoint\"}[$__rate_interval]))", "format": "heatmap", "legendFormat": "{{le}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Kernel per-QP RTT + send latency",
      "description": "Per-QP probe RTT (a keepalive, suppressed on busy QPs) and per-QP data-path send-completion latency (sampled by the traffic itself — design 52). Spread across QPs is the fairness lens.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 3, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "RTT", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "urp_qp_rtt_ns{endpoint=~\"$endpoint\"} / 1e9", "legendFormat": "probe RTT {{endpoint}} qp{{qp}}" },
        { "refId": "SEND", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "urp_qp_send_lat_ns{endpoint=~\"$endpoint\"} / 1e9", "legendFormat": "send-lat {{endpoint}} qp{{qp}}" }
      ]
    }
  ]
}
