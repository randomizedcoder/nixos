{
  "title": "PowerDNS Recursor (hp4)",
  "uid": "pdns-recursor",
  "tags": ["dns", "pdns", "recursor", "sansovino"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Queries / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "qps", "decimals": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_questions[$__rate_interval]))", "legendFormat": "qps" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_cache_hits[$__rate_interval])) / clamp_min(sum(rate(pdns_recursor_cache_hits[$__rate_interval])) + sum(rate(pdns_recursor_cache_misses[$__rate_interval])), 1)", "legendFormat": "hit ratio" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg answer latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 2 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pdns_recursor_qa_latency / 1000", "legendFormat": "latency" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Concurrent queries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pdns_recursor_concurrent_queries", "legendFormat": "in-flight" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Resident memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pdns_recursor_real_memory_usage", "legendFormat": "rss" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pdns_recursor_uptime", "legendFormat": "uptime" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Query pipeline (per second)",
      "description": "Questions received vs record-cache hits/misses vs outgoing queries to auth servers.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "qps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_questions[$__rate_interval]))", "legendFormat": "questions in" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_cache_hits[$__rate_interval]))", "legendFormat": "cache hits" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_cache_misses[$__rate_interval]))", "legendFormat": "cache misses" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_all_outqueries[$__rate_interval]))", "legendFormat": "outqueries" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Answers by response code (per second)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "qps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_noerror_answers[$__rate_interval]))", "legendFormat": "NOERROR" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_nxdomain_answers[$__rate_interval]))", "legendFormat": "NXDOMAIN" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_servfail_answers[$__rate_interval]))", "legendFormat": "SERVFAIL" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Answer latency distribution (per second)",
      "description": "Answers bucketed by how long they took to resolve. A healthy cache keeps most in 0-1ms.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "qps", "custom": { "drawStyle": "line", "fillOpacity": 30, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_answers0_1[$__rate_interval]))", "legendFormat": "0-1 ms" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_answers1_10[$__rate_interval]))", "legendFormat": "1-10 ms" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_answers10_100[$__rate_interval]))", "legendFormat": "10-100 ms" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_answers100_1000[$__rate_interval]))", "legendFormat": "100-1000 ms" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_answers_slow[$__rate_interval]))", "legendFormat": "slow (>1 s)" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Cache occupancy (entries)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pdns_recursor_cache_entries", "legendFormat": "record cache" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pdns_recursor_packetcache_entries", "legendFormat": "packet cache" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "DNSSEC validation results (per second)",
      "description": "Secure = validated signed, Insecure = unsigned (no DS), Bogus = validation FAILED (served as SERVFAIL), NTA/Indeterminate = negative-trust / no chain.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "qps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [
        { "matcher": { "id": "byName", "options": "Bogus" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
      ] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_dnssec_result_secure[$__rate_interval]))", "legendFormat": "Secure" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_dnssec_result_insecure[$__rate_interval]))", "legendFormat": "Insecure" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_dnssec_result_bogus[$__rate_interval]))", "legendFormat": "Bogus" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_dnssec_result_nta[$__rate_interval]))", "legendFormat": "NTA" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_dnssec_result_indeterminate[$__rate_interval]))", "legendFormat": "Indeterminate" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Outgoing resolver health (per second)",
      "description": "Timeouts, throttled auth servers, and unreachable auth servers — non-zero here means upstream recursion trouble.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_outgoing_timeouts[$__rate_interval]))", "legendFormat": "timeouts" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_throttled_out[$__rate_interval]))", "legendFormat": "throttled out" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pdns_recursor_unreachables[$__rate_interval]))", "legendFormat": "unreachables" }
      ]
    }
  ]
}
