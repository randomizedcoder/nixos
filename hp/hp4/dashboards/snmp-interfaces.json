{
  "title": "SNMP Interfaces (CRS310 / Juniper)",
  "uid": "snmp-interfaces",
  "tags": ["snmp", "network", "sansovino"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(ifHCInOctets, instance)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Inbound bitrate (bps) by interface",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ifHCInOctets{instance=~\"$instance\"}[$__rate_interval]) * 8",
          "legendFormat": "{{instance}} {{ifName}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outbound bitrate (bps) by interface",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ifHCOutOctets{instance=~\"$instance\"}[$__rate_interval]) * 8",
          "legendFormat": "{{instance}} {{ifName}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Interface errors + discards (per second)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "pps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(ifInErrors{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}} {{ifName}} in-err" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(ifOutErrors{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}} {{ifName}} out-err" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(ifInDiscards{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}} {{ifName}} in-disc" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(ifOutDiscards{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}} {{ifName}} out-disc" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Operational interfaces (ifOperStatus up)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "count by (instance) (ifOperStatus{instance=~\"$instance\", ifOperStatus=\"up\"} == 1)", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Device uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sysUpTime{instance=~\"$instance\"} / 100", "legendFormat": "{{instance}}" }
      ]
    }
  ]
}
