              "network": 2,
              "oui": 3,
              "ip": 4,
              "Value #A": 5,
              "Value #B": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
