From 8504d0dca46b799d78141ed6bf55c97cb04205ad Mon Sep 17 00:00:00 2001
From: Dave Seddon <dave.seddon.ca@gmail.com>
Date: Mon, 15 Jun 2026 09:38:13 -0700
Subject: [PATCH RFC v3 3/4] net: flow_dissector: extend VLAN fast-path to QinQ
 (depth-2)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Lift the single-VLAN fast-path's depth limit from 1 to 2 so two
stacked 802.1AD / 802.1Q tags (canonical QinQ S-tag + C-tag) are also
fast-pathed. The outer tag is written to FLOW_DISSECTOR_KEY_VLAN, the
inner to FLOW_DISSECTOR_KEY_CVLAN, mirroring the slow-path's
MAX → VLAN → CVLAN state machine.

  - What's changed in the helper. flow_dissect_fast_vlan() takes a
    new vlan_depth parameter. Outer tag (depth 0) writes _KEY_VLAN
    as before; inner tag (depth 1) writes _KEY_CVLAN. HW-stripped
    tags are only ever outermost. The inner-proto switch grows
    cases for ETH_P_8021Q / ETH_P_8021AD that recurse with
    vlan_depth + 1. Past depth 1 the helper returns false (defers
    to slow path).

  - Gate. New DEFINE_STATIC_KEY_FALSE(flow_dissector_qinq_key),
    externed in <net/flow_dissector.h>, sysctl
    /proc/sys/net/flow_dissector/qinq. The depth-≥-1 branch in the
    helper checks this; depth-0 entry remains gated by the vlan key.

  - Sibling-key handling. The qinq sysctl has a custom proc_handler
    proc_set_qinq_key that auto-enables flow_dissector_vlan_key on
    write of 1 (QinQ extends VLAN; depth-0 entry is gated by vlan).
    The previous patch's proc_set_vlan_key is updated to clear
    flow_dissector_qinq_key on write of 0 (depth-2 cannot fire when
    the outer entry is off). Reads always reflect the underlying
    key state.

  - Cost. On a miss, the qinq case is a forward not-taken JMP. On a
    hit at depth 1, the inner tag write + recurse is ~5 ns added to
    the depth-0 cost; the slow-path's second VLAN proto_again rewind
    is skipped — net saving ~50 ns/skb on the eligible QinQ shape.

Verified on the xdp2 testbed pair pi5-1 <-> pi5-2: -6.4 percentage
points of host_system CPU on the QinQ UDP cells with the qinq sysctl
flipped on (same shape as the vlan UDP result in the parent patch).

Signed-off-by: Dave Seddon <dave.seddon.ca@gmail.com>
---
 Documentation/admin-guide/sysctl/net.rst | 17 +++++
 include/net/flow_dissector.h             |  1 +
 net/core/flow_dissector.c                | 87 ++++++++++++++++++++----
 3 files changed, 91 insertions(+), 14 deletions(-)

diff --git a/Documentation/admin-guide/sysctl/net.rst b/Documentation/admin-guide/sysctl/net.rst
index 07cff612d5fb..f470f5382ac5 100644
--- a/Documentation/admin-guide/sysctl/net.rst
+++ b/Documentation/admin-guide/sysctl/net.rst
@@ -500,6 +500,23 @@ sysctl).
 
 Default: 0
 
+qinq
+~~~~
+
+Lifts the vlan fast-path's depth limit from 1 to 2 so two stacked
+802.1AD / 802.1Q tags (canonical QinQ S-tag + C-tag, or two stacked
+802.1Q tags) are also fast-pathed. Outer tag is written to
+FLOW_DISSECTOR_KEY_VLAN, inner to FLOW_DISSECTOR_KEY_CVLAN, mirroring
+the slow-path's MAX → VLAN → CVLAN state machine. Byte-identical
+with the slow path for the eligible shape.
+
+Auto-toggle: writing qinq=1 also enables vlan (QinQ extends VLAN;
+the depth-0 entry of the helper is gated by the vlan key). Writing
+vlan=0 also clears qinq (depth-2 cannot fire when the outer entry
+is off).
+
+Default: 0
+
 3. /proc/sys/net/unix - Parameters for Unix domain sockets
 ----------------------------------------------------------
 
diff --git a/include/net/flow_dissector.h b/include/net/flow_dissector.h
index 22e7ab0153de..6b48103c36e5 100644
--- a/include/net/flow_dissector.h
+++ b/include/net/flow_dissector.h
@@ -433,6 +433,7 @@ extern struct flow_dissector flow_keys_basic_dissector;
  */
 extern struct static_key_false flow_dissector_eth_ip_key;
 extern struct static_key_false flow_dissector_vlan_key;
+extern struct static_key_false flow_dissector_qinq_key;
 
 /* struct flow_keys_digest:
  *
diff --git a/net/core/flow_dissector.c b/net/core/flow_dissector.c
index 7c11c942417c..f89af877dbc8 100644
--- a/net/core/flow_dissector.c
+++ b/net/core/flow_dissector.c
@@ -47,6 +47,8 @@ DEFINE_STATIC_KEY_FALSE(flow_dissector_eth_ip_key);
 EXPORT_SYMBOL(flow_dissector_eth_ip_key);
 DEFINE_STATIC_KEY_FALSE(flow_dissector_vlan_key);
 EXPORT_SYMBOL(flow_dissector_vlan_key);
+DEFINE_STATIC_KEY_FALSE(flow_dissector_qinq_key);
+EXPORT_SYMBOL(flow_dissector_qinq_key);
 
 /* Forward declarations for the per-shape fast-path helpers, anchored
  * at the top of the file. Subsequent patches in this series add new
@@ -1238,27 +1240,47 @@ static bool flow_dissect_fast_ipv6(const struct sk_buff *skb,
 	return true;
 }
 
-/* Strip a single 802.1Q or 802.1AD tag (HW-stripped or in-band),
- * optionally write key_vlan / num_of_vlans, then dispatch to the
- * IPv4 / IPv6 fast-path helper on the inner ethertype. Byte-identical
- * with the slow path for the eligibility shape; defers on any miss.
+/* Strip up to two 802.1Q / 802.1AD tags (single VLAN at depth 0; QinQ
+ * S-tag + C-tag, or two stacked 802.1Q tags, at depth 1). Outer tag →
+ * FLOW_DISSECTOR_KEY_VLAN, inner → FLOW_DISSECTOR_KEY_CVLAN, mirroring
+ * the slow path's MAX → VLAN → CVLAN state machine. Past two tags,
+ * defer to slow path. Byte-identical with the slow path for the
+ * eligibility shape.
+ *
+ * The depth-0 entry is reached from the dispatcher only when
+ * flow_dissector_vlan_key is on; the depth-≥-1 entry is gated by
+ * flow_dissector_qinq_key. The qinq sysctl's proc_handler also flips
+ * vlan on whenever qinq is enabled, so callers don't have to remember
+ * the dependency.
  */
 static bool flow_dissect_fast_vlan(const struct sk_buff *skb,
 				   struct flow_dissector *flow_dissector,
 				   void *target_container,
 				   const void *data,
-				   __be16 proto, int nhoff, int hlen)
+				   __be16 proto, int nhoff, int hlen,
+				   int vlan_depth)
 {
 	struct flow_dissector_key_num_of_vlans *key_nvs;
 	struct flow_dissector_key_vlan *key_vlan;
+	enum flow_dissector_key_id vlan_key;
 	__be16 inner_proto;
 	__be16 saved_tpid;
 	u16 tci_id;
 	u16 tci_prio;
 
+	if (vlan_depth >= 1 &&
+	    !static_branch_likely(&flow_dissector_qinq_key))
+		return false;
+	if (vlan_depth >= 2)
+		return false;
+
+	vlan_key = vlan_depth == 0 ?
+		   FLOW_DISSECTOR_KEY_VLAN :
+		   FLOW_DISSECTOR_KEY_CVLAN;
 	saved_tpid = proto;
 
-	if (skb && skb_vlan_tag_present(skb)) {
+	/* HW-stripped tag is only ever the outermost. */
+	if (vlan_depth == 0 && skb && skb_vlan_tag_present(skb)) {
 		tci_id = skb_vlan_tag_get_id(skb);
 		tci_prio = skb_vlan_tag_get_prio(skb);
 		inner_proto = skb->protocol;
@@ -1275,10 +1297,9 @@ static bool flow_dissect_fast_vlan(const struct sk_buff *skb,
 		nhoff += (int)sizeof(*vlan);
 	}
 
-	if (dissector_uses_key(flow_dissector,
-			       FLOW_DISSECTOR_KEY_VLAN)) {
+	if (dissector_uses_key(flow_dissector, vlan_key)) {
 		key_vlan = skb_flow_dissector_target(flow_dissector,
-						     FLOW_DISSECTOR_KEY_VLAN,
+						     vlan_key,
 						     target_container);
 		key_vlan->vlan_id = tci_id;
 		key_vlan->vlan_priority = tci_prio;
@@ -1302,6 +1323,12 @@ static bool flow_dissect_fast_vlan(const struct sk_buff *skb,
 		return flow_dissect_fast_ipv6(skb, flow_dissector,
 					      target_container, data,
 					      nhoff, hlen);
+	case htons(ETH_P_8021Q):
+	case htons(ETH_P_8021AD):
+		return flow_dissect_fast_vlan(skb, flow_dissector,
+					      target_container, data,
+					      inner_proto, nhoff, hlen,
+					      vlan_depth + 1);
 	default:
 		return false;
 	}
@@ -1333,7 +1360,7 @@ static bool flow_dissect_fast(const struct sk_buff *skb,
 			return false;
 		return flow_dissect_fast_vlan(skb, flow_dissector,
 					      target_container, data,
-					      proto, nhoff, hlen);
+					      proto, nhoff, hlen, 0);
 	case htons(ETH_P_IP):
 		if (!static_branch_likely(&flow_dissector_eth_ip_key))
 			return false;
@@ -2427,14 +2454,39 @@ core_initcall(init_default_flow_dissectors);
  * /proc/sys/net/flow_dissector/. See Documentation/admin-guide/sysctl/
  * net.rst for the operator-facing description.
  */
-/* proc_handler for net.flow_dissector.vlan. Today a thin wrapper
- * around proc_do_static_key; the follow-up QinQ patch in this series
- * adds sibling-key handling here (clear qinq when vlan is set to 0).
+/* proc_handler for net.flow_dissector.vlan. Writes of 0 also clear
+ * flow_dissector_qinq_key — QinQ depth-2 is meaningless when the
+ * outer single-VLAN gate is off, so the slow path would have to
+ * handle every VLAN-tagged packet anyway.
  */
 static int proc_set_vlan_key(const struct ctl_table *table, int write,
 			     void *buffer, size_t *lenp, loff_t *ppos)
 {
-	return proc_do_static_key(table, write, buffer, lenp, ppos);
+	int ret;
+
+	ret = proc_do_static_key(table, write, buffer, lenp, ppos);
+	if (ret == 0 && write &&
+	    !static_branch_unlikely(&flow_dissector_vlan_key) &&
+	    static_branch_unlikely(&flow_dissector_qinq_key))
+		static_branch_disable(&flow_dissector_qinq_key);
+	return ret;
+}
+
+/* proc_handler for net.flow_dissector.qinq. Writes of 1 also enable
+ * flow_dissector_vlan_key — QinQ extends the VLAN fast-path to depth
+ * 2; it cannot fire when the depth-0 entry is gated off.
+ */
+static int proc_set_qinq_key(const struct ctl_table *table, int write,
+			     void *buffer, size_t *lenp, loff_t *ppos)
+{
+	int ret;
+
+	ret = proc_do_static_key(table, write, buffer, lenp, ppos);
+	if (ret == 0 && write &&
+	    static_branch_unlikely(&flow_dissector_qinq_key) &&
+	    !static_branch_unlikely(&flow_dissector_vlan_key))
+		static_branch_enable(&flow_dissector_vlan_key);
+	return ret;
 }
 
 static struct ctl_table flow_dissector_sysctl_table[] = {
@@ -2452,6 +2504,13 @@ static struct ctl_table flow_dissector_sysctl_table[] = {
 		.mode		= 0644,
 		.proc_handler	= proc_set_vlan_key,
 	},
+	{
+		.procname	= "qinq",
+		.data		= &flow_dissector_qinq_key.key,
+		.maxlen		= sizeof(flow_dissector_qinq_key),
+		.mode		= 0644,
+		.proc_handler	= proc_set_qinq_key,
+	},
 };
 
 static int __init flow_dissector_sysctl_init(void)
-- 
2.54.0

